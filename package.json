{
  "name": "old-traveler-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/db-start.js",
    "start": "node ./bin/www",
    "db:start": "node scripts/db-start.js",
    "db:start:seed": "node scripts/db-start.js --seed",
    "db:stop": "docker compose stop db",
    "db:reset": "docker compose down -v && node scripts/db-start.js --seed",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:psql": "docker exec -it old-traveler-db sh -c \"psql -U $POSTGRES_USER -d $POSTGRES_DB\"",
    "pretest": "node scripts/db-start.js",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^18.0.6",
    "express": "~4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  }
}
