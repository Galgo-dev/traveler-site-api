# Copier ce fichier en .env et renseigner les valeurs (le .env n'est jamais commité).
NODE_ENV=development
PORT=3000

# Base de données PostgreSQL (conteneur Docker, voir docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=old_traveler
DB_USER=old_traveler
DB_PASSWORD=change-moi

# Compte administrateur créé par le seeder (npm run db:seed)
ADMIN_EMAIL=gerante@horizons-lointains.be
ADMIN_PASSWORD=Change-Moi-2026!
ADMIN_NOM=Gérante
ADMIN_PRENOM=Admin

# Authentification (JWT) — générer un secret long et aléatoire, ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a-remplacer-par-un-secret-long-et-aleatoire
JWT_EXPIRES_IN=8h

# Front-end (CORS + lien de réinitialisation du mot de passe)
CORS_ORIGIN=http://localhost:5173
FRONT_URL=http://localhost:5173
RESET_TOKEN_MINUTES=60

# Demandes de voyage (v2) : délai minimum en jours entre la commande et le départ (R3)
DEMANDE_DELAI_MIN_JOURS=7

# Avis clients (v3) : délai de modification / suppression par le client (R9),
# et délai maximal pour rédiger un avis après le retour (P2, vide = illimité)
AVIS_DELAI_MODIFICATION_JOURS=30
AVIS_DELAI_MAX_JOURS=

# E-mails (mot de passe oublié). SMTP_HOST vide = mails affichés dans la console du serveur.
# Développement : Mailpit (démarré par npm start) capture les mails → http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Horizons Lointains <no-reply@horizons-lointains.be>
# Production, exemple :
#   SMTP_HOST=smtp.fournisseur.be
#   SMTP_PORT=587          (ou 465 avec SMTP_SECURE=true)
#   SMTP_USER=no-reply@horizons-lointains.be
#   SMTP_PASSWORD=mot-de-passe-du-compte-mail
